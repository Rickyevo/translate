# Normalize line endings in the repository; check out with the platform's native endings.
* text=auto

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.pyd binary
*.zip binary

# Generated dictionary data (sorted, byte-exact: the backend binary-searches it) — never rewrite line endings
backend/translate_backend/data/cedict.tsv -text
